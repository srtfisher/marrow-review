{
  "name": "marrow-review",
  "version": "0.2.0",
  "description": "Review large pull requests in the terminal: the diff abridged to what carries meaning, findings anchored to lines, one GitHub review.",
  "license": "MIT",
  "author": "Sean Fisher",
  "type": "module",
  "bin": {
    "marrow": "./dist/cli.js",
    "marrow-review": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint:boundary": "depcruise src --config .dependency-cruiser.cjs",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srtfisher/marrow-review.git"
  },
  "homepage": "https://github.com/srtfisher/marrow-review#readme",
  "bugs": {
    "url": "https://github.com/srtfisher/marrow-review/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "diff",
    "github",
    "cli",
    "tui",
    "ink",
    "claude"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.222",
    "@octokit/rest": "22.0.1",
    "cli-highlight": "^2.1.11",
    "ink": "7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "6.0.0",
    "react": "^19.2.0",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "dependency-cruiser": "^16.0.0",
    "typescript": "^5.6.0"
  }
}
