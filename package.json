{
  "name": "marrow-review",
  "version": "0.4.3",
  "description": "Review large pull requests in a local web app: the diff abridged to what carries meaning, grouped by intent, findings anchored to lines, one GitHub review.",
  "license": "MIT",
  "author": "Sean Fisher",
  "type": "module",
  "bin": {
    "marrow": "./dist/cli.js",
    "marrow-review": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json",
    "lint:boundary": "depcruise src --config .dependency-cruiser.cjs",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "dev:web": "vite build --watch",
    "e2e": "bun run build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srtfisher/marrow-review.git"
  },
  "homepage": "https://github.com/srtfisher/marrow-review#readme",
  "bugs": {
    "url": "https://github.com/srtfisher/marrow-review/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "diff",
    "github",
    "cli",
    "claude",
    "web"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.222",
    "@octokit/rest": "22.0.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^16.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.2"
  }
}
